# Flask
SECRET_KEY=change-me-to-a-random-string

# Database. Leave DB_HOST empty to use SQLite automatically.
DB_HOST=
DB_PORT=3306
DB_NAME=humisense
DB_USER=
DB_PASSWORD=

# AI Gateway. Leave AI_PROVIDER as mock for Demo AI.
# Options: mock | openai_compatible | gemini
AI_PROVIDER=mock
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Demo mode always on for the expo build.
DEMO_MODE=true